// Waybar — sharp Catppuccin Mocha
// Based on sanjar-xolmatov/hyprland-dotfiles (archived), adapted. Managed via ~/.agents (see LOG.md)
{
  "layer": "top",
  "position": "top",
  "height": 38,
  "spacing": 0,
  "exclusive": true,
  "reload_style_on_change": true,

  "modules-left": ["hyprland/workspaces"],
  "modules-center": [],
  "modules-right": [
    "mpris",
    "tray",
    "pulseaudio",
    "cpu",
    "memory",
    "disk",
    "clock"
  ],

  "hyprland/workspaces": {
    "format": "{name}",
    "all-outputs": false,
    "sort-by-number": true,
    "show-special": false,
    "tooltip": false
  },

  // Follows whichever player is active — YT Music in LibreWolf shows up as "firefox.instance_*"
  "mpris": {
    "format": "{status_icon}  {dynamic}",
    "format-paused": "{status_icon}  <i>{dynamic}</i>",
    "format-stopped": "",
    "dynamic-order": ["title", "artist"],
    "dynamic-separator": " · ",
    "dynamic-len": 45,
    "status-icons": {
      "playing": "󰏤",
      "paused": "󰐊",
      "stopped": "󰓛"
    },
    "tooltip-format": "{player}: {title} — {artist}",
    "on-click": "playerctl play-pause",
    "on-click-right": "playerctl next",
    "on-click-middle": "playerctl previous",
    "on-scroll-up": "playerctl next",
    "on-scroll-down": "playerctl previous"
  },

  "tray": {
    "icon-size": 16,
    "spacing": 12,
    "show-passive-items": true
  },

  "pulseaudio": {
    "format": "{icon}  {volume}%",
    "format-muted": "󰝟  muted",
    "format-icons": {
      "headphone": "󰋋",
      "headset": "󰋎",
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    "scroll-step": 5,
    "tooltip-format": "{desc}: {volume}%",
    "on-click": "pavucontrol",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
  },

  "cpu": {
    "format": "cpu {usage}%",
    "interval": 3,
    "tooltip": false,
    "states": { "warning": 70, "critical": 90 }
  },

  "memory": {
    "format": "mem {used:0.1f}G",
    "interval": 4,
    "tooltip-format": "RAM {used:0.1f}G / {total:0.1f}G · swap {swapUsed:0.1f}G",
    "states": { "warning": 75, "critical": 90 }
  },

  "disk": {
    "format": "disk {percentage_used}%",
    "paths": ["/"],
    "interval": 30,
    "tooltip-format": "/ — {used} used of {total} ({free} free)"
  },

  "clock": {
    "format": "{:%H:%M}",
    "format-alt": "{:%a %d %b  %H:%M}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "weeks-pos": "right",
      "first-day-of-week": 1,
      "on-scroll": 1,
      "format": {
        "months":   "<span color='#cba6f7'><b>{}</b></span>",
        "days":     "<span color='#cdd6f4'>{}</span>",
        "weeks":    "<span color='#6c7086'>W{}</span>",
        "weekdays": "<span color='#f9e2af'><b>{}</b></span>",
        "today":    "<span color='#11111b' background='#89b4fa'><b>{}</b></span>"
      }
    },
    "actions": {
      "on-click-right": "mode",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    }
  }
}
