/**
 * Rofi — sharp Catppuccin Mocha launcher
 * Based on sanjar-xolmatov/hyprland-dotfiles (archived), squared off.
 * Spacing standard: 10px. Managed via ~/.agents (see LOG.md)
 *
 * Try: rofi -show drun
 */

configuration {
    modi:                 "drun,run,window";
    show-icons:           true;
    icon-theme:           "breeze-dark";
    display-drun:         " Apps";
    display-run:          " Run";
    display-window:       " Windows";
    drun-display-format:  "{name}";
    font:                 "JetBrainsMono Nerd Font 11";
    terminal:             "kitty";
    run-command:          "uwsm app -- {cmd}";
    hover-select:         true;
    me-select-entry:      "MousePrimary";
    me-accept-entry:      "MouseDPrimary";
    sort:                 true;
    sorting-method:       "fzf";
    matching:             "fuzzy";
    kb-cancel:            "Escape,Super+space";
}

* {
    base:     #1e1e2eff;
    mantle:   #181825ff;
    crust:    #11111bff;
    text:     #cdd6f4ff;
    subtext0: #a6adc8ff;
    overlay0: #6c7086ff;
    surface0: #313244ff;
    surface1: #45475aff;
    mauve:    #cba6f7ff;
    lavender: #b4befeff;
    red:      #f38ba8ff;

    background-color: transparent;
    text-color:       @text;
    margin:  0px;
    padding: 0px;
    spacing: 0px;
}

window {
    location:         center;
    width:            600px;
    background-color: @base;
    border:           2px;
    border-color:     @mauve;
    border-radius:    0px;
}

mainbox {
    children: [ inputbar, message, listview, mode-switcher ];
    spacing:  10px;
    padding:  10px;
}

inputbar {
    background-color: @mantle;
    padding:          10px 12px;
    spacing:          10px;
    border:           0px 0px 1px 0px;
    border-color:     @surface1;
    children:         [ prompt, entry ];
}

prompt {
    text-color: @mauve;
    font:       "JetBrainsMono Nerd Font Bold 11";
}

entry {
    placeholder:       "Search…";
    placeholder-color: @overlay0;
    cursor:            text;
}

message {
    background-color: @mantle;
    padding:          8px 12px;
}
textbox { text-color: @subtext0; }

listview {
    columns:      1;
    lines:        8;
    spacing:      2px;
    fixed-height: true;
    scrollbar:    false;
    cycle:        true;
}

element {
    padding:  8px 12px;
    spacing:  12px;
    border:   0px 0px 0px 3px;
    border-color: transparent;
}
element normal.normal, element alternate.normal {
    background-color: transparent;
    text-color:       @text;
}
element selected.normal {
    background-color: @surface0;
    text-color:       @lavender;
    border-color:     @mauve;
}
element normal.urgent, element alternate.urgent { text-color: @red; }
element normal.active, element alternate.active { text-color: @mauve; }

element-icon {
    size:           22px;
    vertical-align: 0.5;
}
element-text {
    vertical-align: 0.5;
    text-color:     inherit;
}

mode-switcher {
    spacing: 0px;
}
button {
    padding:    6px;
    text-color: @overlay0;
    border:     0px 0px 2px 0px;
    border-color: transparent;
}
button selected {
    text-color:   @mauve;
    border-color: @mauve;
    background-color: @mantle;
}
